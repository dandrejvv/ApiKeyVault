<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ApiKeyVault.Core\ApiKeyVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>akv</AssemblyName>
    <RootNamespace>ApiKeyVault.Cli</RootNamespace>
    <!-- Packs as a .NET global tool named "akv" (see README, Build and Install) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>akv</ToolCommandName>
    <PackageId>ApiKeyVault.Cli</PackageId>
  </PropertyGroup>

</Project>
