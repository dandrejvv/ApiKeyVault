<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiKeyVault.UI.ViewModels"
        x:Class="ApiKeyVault.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ApiKeyVault"
        Width="1080" Height="700"
        MinWidth="880" MinHeight="550"
        Background="{StaticResource SurfaceLowestBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- ======================================================== -->
        <!-- 1. FIRST RUN WIZARD (Obsidian Vault v2)                  -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsFirstRun}" Background="{StaticResource SurfaceLowestBrush}" Padding="24" AutomationProperties.AutomationId="FirstRun.View">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Width="520" Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <!-- Header Icon & Branding -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Welcome to ApiKeyVault" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Create your secure encrypted vault to store API keys across all your devices."
                                       TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" FontSize="13" />
                        </StackPanel>

                        <!-- Vault Folder Selection -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="VAULT STORAGE FOLDER" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding FirstRunDirectory}" AutomationProperties.AutomationId="FirstRun.Directory" Height="38" />
                                <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseFirstRunFolderCommand}" Classes="secondary" Margin="8,0,0,0" Height="38" />
                            </Grid>
                        </StackPanel>

                        <!-- Vault File Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="VAULT FILENAME" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            <TextBox Text="{Binding FirstRunFileName}" AutomationProperties.AutomationId="FirstRun.FileName" Height="38" />
                        </StackPanel>

                        <!-- Target Path Telemetry Preview Chip with Copy -->
                        <Border Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding FirstRunVaultPath, StringFormat='Target: {0}'}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Copy" Command="{Binding CopyTargetVaultPathCommand}" Classes="subtle" FontSize="11" Foreground="{StaticResource SecondaryBrush}" Margin="8,0,0,0" Padding="6,2" />
                            </Grid>
                        </Border>

                        <!-- Master Passphrase & Strength Meter -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="MASTER PASSPHRASE" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            <TextBox PasswordChar="•" Text="{Binding FirstRunPassphrase}" AutomationProperties.AutomationId="FirstRun.Passphrase" Height="38">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreateVaultCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <!-- 4-Segment Strength Bar -->
                            <Grid ColumnDefinitions="*, *, *, *" Margin="0,4,0,2">
                                <Border Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,2,0"
                                        Background="{Binding IsStrengthBar1Active, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="2,0,2,0"
                                        Background="{Binding IsStrengthBar2Active, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="2,0,2,0"
                                        Background="{Binding IsStrengthBar3Active, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Border Grid.Column="3" Height="4" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{Binding IsStrengthBar4Active, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>

                            <TextBlock Text="{Binding PassphraseStrengthText}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource SecondaryBrush}" />
                        </StackPanel>

                        <!-- Confirm Passphrase -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="CONFIRM PASSPHRASE" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            <TextBox PasswordChar="•" Text="{Binding FirstRunConfirmPassphrase}" AutomationProperties.AutomationId="FirstRun.ConfirmPassphrase" Height="38">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreateVaultCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding FirstRunErrorMessage}" Foreground="{StaticResource StatusDangerBrush}" IsVisible="{Binding FirstRunErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Primary Action Button -->
                        <Button Content="Create Encrypted Vault" Command="{Binding CreateVaultCommand}"
                                Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsDefault="True"
                                AutomationProperties.AutomationId="FirstRun.CreateButton" Height="42" Margin="0,8,0,0" />

                        <!-- Footer Links -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,4,0,0">
                            <Button Content="📂 Choose Existing Vault..." Command="{Binding ChooseExistingVaultOnFirstRunCommand}" Classes="subtle" FontSize="12" />
                            <Button Content="Go to Unlock Screen" Command="{Binding SwitchToLockScreenCommand}" Classes="subtle" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. LOCK SCREEN (Obsidian Vault v2)                       -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsLocked}" Background="{StaticResource SurfaceLowestBrush}" Padding="24" AutomationProperties.AutomationId="Unlock.View">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Width="480" Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <!-- Header Icon & Branding -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="ApiKeyVault" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter master passphrase to unlock vault" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center" FontSize="13" />
                        </StackPanel>

                        <!-- Targeted Vault Card -->
                        <Border Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding TargetVaultFileName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource OnSurfaceBrush}" />
                                    <TextBlock Text="{Binding TargetVaultDirectory}" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="📂 Change..." Command="{Binding BrowseOtherVaultCommand}" Classes="secondary" Height="32" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Passphrase Field -->
                        <TextBox PasswordChar="•" Text="{Binding UnlockPassphrase}"
                                 AutomationProperties.AutomationId="Unlock.Passphrase"
                                 Watermark="Master Passphrase" Height="38">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding UnlockErrorMessage}" Foreground="{StaticResource StatusDangerBrush}"
                                   IsVisible="{Binding UnlockErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Unlock Button (Primary Emerald) -->
                        <Button Content="Unlock Vault" Command="{Binding UnlockCommand}"
                                Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsDefault="True"
                                AutomationProperties.AutomationId="Unlock.Button" Height="40" />

                        <!-- Recent Vaults Section -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="RECENT VAULTS" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                
                                <ItemsControl ItemsSource="{Binding RecentVaults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:RecentVaultItemViewModel">
                                            <Border Margin="0,3" Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                                <Grid ColumnDefinitions="*, Auto, Auto">
                                                    <Button Grid.Column="0" Classes="subtle"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectRecentVaultCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource OnSurfaceBrush}" />
                                                            <TextBlock Text="{Binding DirectoryPath}" FontSize="10" Foreground="{StaticResource OnSurfaceMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                    
                                                    <Border Grid.Column="1" IsVisible="{Binding IsActive}" Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="SELECTED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" />
                                                    </Border>

                                                    <Button Grid.Column="2" Content="✕" Classes="subtle"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentVaultCommand}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{StaticResource OnSurfaceMutedBrush}" Padding="6,2" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Lock Screen Bottom Links -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,6,0,0">
                                    <Button Content="➕ Create New Vault" Command="{Binding CreateNewVaultFromLockScreenCommand}" Classes="subtle" FontSize="12" />
                                    <Button Content="📂 Open Other File..." Command="{Binding BrowseOtherVaultCommand}" Classes="subtle" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. UNLOCKED MAIN WORKSPACE (Obsidian Vault v2)           -->
        <!-- ======================================================== -->
        <Grid IsVisible="{Binding IsUnlocked}" RowDefinitions="*, Auto">
            <!-- 3-Column Layout: Sidebar (Full Height) | Key List Table | Collapsible Inspector Panel -->
            <Grid Grid.Row="0" ColumnDefinitions="190, *, Auto">
                <!-- ==================== COLUMN 0: SIDEBAR ==================== -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,16">
                    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                        <!-- 1. Logo & App Branding -->
                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="🛡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#020617" />
                                </Border>
                                <TextBlock Text="ApiKeyVault" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- User / Machine Profile Pill -->
                            <Border Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{StaticResource SurfaceContainerHighestBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveVaultFileName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="●" FontSize="7" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="vault unlocked" FontSize="10" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 2. Search Box in Sidebar -->
                        <TextBox Grid.Row="1" Text="{Binding SearchText}"
                                 Watermark="🔍 Search keys..."
                                 Height="36" Margin="0,0,0,14"
                                 AutomationProperties.AutomationId="Search.Box" />

                        <!-- 3. Primary CTA: Add Key -->
                        <Button Grid.Row="2" Content="+ Add API Key" Command="{Binding OpenAddKeyDialogCommand}"
                                Classes="primary" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,14"
                                AutomationProperties.AutomationId="Nav.AddKey" />

                        <!-- 4. Navigation Categories & Providers List -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="3">
                                <Button HorizontalAlignment="Stretch" Classes="subtle"
                                        Command="{Binding SetFilterCommand}" CommandParameter="all"
                                        AutomationProperties.AutomationId="Nav.AllKeys">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Column="0" Text="🌐" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="All Keys" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{StaticResource SurfaceContainerHighBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding TotalKeysCount}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button HorizontalAlignment="Stretch" Classes="subtle"
                                        Command="{Binding SetFilterCommand}" CommandParameter="attention"
                                        AutomationProperties.AutomationId="Nav.Attention">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Attention" Foreground="{StaticResource StatusWarningBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{StaticResource SurfaceContainerHighBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding AttentionCount}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StatusWarningBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <Separator Margin="0,10" Background="{StaticResource BorderSubtleBrush}" />
                                <TextBlock Text="TAGS" FontFamily="Consolas, monospace" Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="10" FontWeight="Bold" Margin="8,2" />

                                <ItemsControl ItemsSource="{Binding TagFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TagFilterItemViewModel">
                                            <Button HorizontalAlignment="Stretch" Classes="subtle"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetFilterCommand}"
                                                    CommandParameter="{Binding Tag, StringFormat='tag:{0}'}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{Binding Color}" Margin="2,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Tag}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceContainerHighBrush}" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Margin="0,10" Background="{StaticResource BorderSubtleBrush}" />
                                <TextBlock Text="PLATFORMS" FontFamily="Consolas, monospace" Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="10" FontWeight="Bold" Margin="8,2" />

                                <ItemsControl ItemsSource="{Binding ProviderFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ProviderFilterItemViewModel">
                                            <Button HorizontalAlignment="Stretch" Classes="subtle"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetFilterCommand}"
                                                    CommandParameter="{Binding Name}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="●" FontSize="8" Foreground="{StaticResource PrimaryBrush}" Margin="2,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceContainerHighBrush}" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 5. Bottom Utilities -->
                        <StackPanel Grid.Row="4" Spacing="4" Margin="0,10,0,0">
                            <Button HorizontalAlignment="Stretch" Classes="subtle"
                                    Command="{Binding SwitchVaultCommand}"
                                    AutomationProperties.AutomationId="Nav.SwitchVault">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📂" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Switch Vault" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button HorizontalAlignment="Stretch" Classes="subtle"
                                    Command="{Binding LockCommand}"
                                    AutomationProperties.AutomationId="Nav.Lock">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Lock Vault" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== COLUMN 1: CENTER KEY TABLE ==================== -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceBaseBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Table Column Headers -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Grid Grid.Column="0" ColumnDefinitions="*, 72, 68, 70, 52">
                                    <TextBlock Grid.Column="0" Text="Key Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Platform" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="Tags" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="Expires" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                                </Grid>
                                <!-- Toggle Details Panel Button -->
                                <Button Grid.Column="1" Command="{Binding ToggleInspectorCommand}"
                                        Classes="subtle" Padding="6,3" Margin="6,0,0,0"
                                        ToolTip.Tip="Toggle details panel">
                                    <TextBlock Text="◧" FontSize="12" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Table Rows List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 Background="Transparent"
                                 Tapped="OnEntryListTapped"
                                 AutomationProperties.AutomationId="Entry.List">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:EntryItemViewModel">
                                    <Grid ColumnDefinitions="*, 72, 68, 70, 52" Margin="2,6" ClipToBounds="True">
                                        <!-- Key Name & Subtitle -->
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="True">
                                            <TextBlock Text="{Binding Address}" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Comment}" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Platform Badge -->
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="5,2" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                                            <TextBlock Text="{Binding ProviderDisplayName}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{StaticResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <!-- Status Dot + Text -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ClipToBounds="True">
                                            <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="9" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Detected Tags Badges -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,4,0" ClipToBounds="True">
                                            <ItemsControl ItemsSource="{Binding VisibleTagBadges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:TagBadgeViewModel">
                                                        <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}"
                                                                BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding Tooltip}">
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{Binding ForegroundColor}" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Overflow Tag Pill (+N) -->
                                            <Border IsVisible="{Binding HasOverflowTags}"
                                                    Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="3,1" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding TagsDisplay}">
                                                <TextBlock Text="{Binding OverflowTagText}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Subtle dash when no tags exist -->
                                            <TextBlock IsVisible="{Binding HasNoTags}" Text="—"
                                                       Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="11" Opacity="0.4"
                                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                                        </StackPanel>

                                        <!-- Expiry Description -->
                                        <TextBlock Grid.Column="4" Text="{Binding ExpiryTableDescription}" ToolTip.Tip="{Binding ExpiryDescription}" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ==================== COLUMN 2: RIGHT INSPECTOR PANEL (COLLAPSIBLE) ==================== -->
                <Border Grid.Column="2" Width="300" IsVisible="{Binding IsInspectorVisible}"
                        Background="{StaticResource SurfaceLowestBrush}" Padding="12" AutomationProperties.AutomationId="Detail.Pane">
                    <Grid>
                        <!-- Empty State Canvas (when 0 entries exist) -->
                        <Border IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}"
                                Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="300">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="🔑" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No Keys Selected" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Create your first API key, or load sample keys to explore ApiKeyVault."
                                           TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" />
                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <Button Content="+ Add API Key" Command="{Binding OpenAddKeyDialogCommand}"
                                            Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" />
                                    <Button Content="✨ Load Sample Keys" Command="{Binding PopulateDemoKeysCommand}"
                                            Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" />
                                    <Button Content="Import from .env / JSON" Command="{Binding ImportKeysCommand}"
                                            Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Key Selected Inspector Card -->
                        <Border IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                                <StackPanel Spacing="11">
                                    <!-- Header: Title + Status Icon + Close Button -->
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,2">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.StatusIcon}" FontSize="14" Foreground="{Binding SelectedEntry.StatusColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedEntry.Address}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding CloseInspectorCommand}"
                                                Classes="subtle" Padding="6,2" VerticalAlignment="Center"
                                                ToolTip.Tip="Close details panel">
                                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                        </Button>
                                    </Grid>

                                    <!-- Description Subtitle (if available) -->
                                    <TextBlock Text="{Binding SelectedEntry.Comment}" FontSize="12" Foreground="{StaticResource OnSurfaceMutedBrush}"
                                               TextWrapping="Wrap" IsVisible="{Binding SelectedEntry.HasComment}" Margin="0,-4,0,2" />

                                    <!-- Compromised Alert Banner -->
                                    <Border IsVisible="{Binding SelectedEntry.IsCompromised}"
                                            Background="#2a1015" BorderBrush="{StaticResource StatusDangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Key is marked as compromised!" FontWeight="Bold" FontSize="11" Foreground="#f87171" />
                                                <TextBlock Text="This key may be leaked. Rotate or revoke it immediately." FontSize="10" Foreground="#fca5a5" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Expiring Alert Banner -->
                                    <Border IsVisible="{Binding SelectedEntry.IsExpiringSoon}"
                                            Background="#2c1a06" BorderBrush="{StaticResource StatusWarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="▲" FontSize="13" Foreground="{StaticResource StatusWarningBrush}" VerticalAlignment="Center" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Key expires soon!" FontWeight="Bold" FontSize="11" Foreground="{StaticResource StatusWarningBrush}" />
                                                <TextBlock Text="{Binding SelectedEntry.ExpiryDescription}" FontSize="10" Foreground="#fde68a" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Revoked Alert Banner -->
                                    <Border IsVisible="{Binding SelectedEntry.IsRevoked}"
                                            Background="#1e293b" BorderBrush="#64748b" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="⊘" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center" />
                                            <TextBlock Text="This key has been revoked and is inactive." FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Secret Field with Monospace & Reveal -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Secret" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Grid.Column="0" Text="{Binding RevealedSecret}" IsReadOnly="True" Height="34" FontFamily="Consolas, monospace" FontSize="12" />
                                            <Button Grid.Column="1" Command="{Binding ToggleRevealSecretCommand}"
                                                    Classes="secondary" Margin="6,0,0,0" Height="34" Padding="10,0"
                                                    AutomationProperties.AutomationId="Entry.Reveal">
                                                <TextBlock Text="👁" FontSize="13" />
                                            </Button>
                                        </Grid>
                                        <!-- Big Emerald Copy Key Button -->
                                        <Button Content="Copy Key" Command="{Binding CopySecretCommand}"
                                                Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Margin="0,4,0,0"
                                                AutomationProperties.AutomationId="Entry.Copy" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Copied!" FontSize="11" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                                                   IsVisible="{Binding ClipboardCountdownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!-- Metadata Properties -->
                                    <Border Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4">
                                        <Grid ColumnDefinitions="95, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" Margin="0,3" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEntry.ProviderDisplayName}" FontSize="11" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right" Margin="0,3" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tags" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" Margin="0,3" />
                                            <Panel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2">
                                                <ItemsControl ItemsSource="{Binding SelectedEntry.TagBadges}" IsVisible="{Binding SelectedEntry.HasTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:TagBadgeViewModel">
                                                            <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}"
                                                                    BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="2,1"
                                                                    ToolTip.Tip="{Binding Tooltip}">
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{Binding ForegroundColor}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="No tags" IsVisible="{Binding SelectedEntry.HasNoTags}"
                                                           FontSize="11" Foreground="{StaticResource OnSurfaceDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Panel>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" Margin="0,3" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntry.StatusText}" FontSize="11" Foreground="{Binding SelectedEntry.StatusColor}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Expires" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" Margin="0,3" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEntry.ExpiryDescription}" FontSize="11" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right" Margin="0,3" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Last Tested" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" Margin="0,3" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEntry.TestStatusDescription}" FontSize="11" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right" Margin="0,3" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                    <!-- Security & Compromised Checkbox Card -->
                                    <Border Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,2">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Security Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                                                <TextBlock Text="Flag if secret is leaked, exposed, or at risk" FontSize="10" Foreground="{StaticResource OnSurfaceMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SelectedEntry.IsCompromised, Mode=OneWay}"
                                                      Command="{Binding ToggleSelectedEntryCompromisedCommand}"
                                                      Content="Compromised"
                                                      FontWeight="SemiBold"
                                                      FontSize="11"
                                                      Foreground="{StaticResource StatusDangerBrush}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                                        <Button Grid.Column="0" Content="{Binding SelectedEntry.RevokeButtonText}" Command="{Binding ToggleSelectedEntryRevokedCommand}"
                                                Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" Margin="0,0,4,0"
                                                AutomationProperties.AutomationId="Entry.Revoke" />
                                        <Button Grid.Column="1" Content="Edit Key" Command="{Binding OpenEditKeyDialogCommand}"
                                                Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" Margin="4,0,0,0"
                                                AutomationProperties.AutomationId="Entry.Edit" />
                                    </Grid>

                                    <!-- Secondary Utility Actions -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,6,0,0">
                                        <Button Grid.Column="0" Content="✓ Test Key" Command="{Binding TestSelectedEntryCommand}"
                                                ToolTip.Tip="{Binding SelectedEntry.TestSupportTooltip}"
                                                Classes="subtle" FontSize="11" Padding="8,4" />
                                        <Button Grid.Column="1" Content="Copy akv run" Command="{Binding CopyAsCommandCommand}"
                                                Classes="subtle" FontSize="11" HorizontalAlignment="Center" Padding="8,4" />
                                        <Button Grid.Column="2" Content="🗑 Delete Key" Command="{Binding DeleteSelectedEntryCommand}"
                                                Classes="subtle" FontSize="11" Foreground="{StaticResource StatusDangerBrush}" HorizontalAlignment="Right" Padding="8,4"
                                                AutomationProperties.AutomationId="Entry.Delete" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Status Strip -->
            <Border Grid.Row="1" Height="26" Background="{StaticResource SurfaceLowestBrush}" Padding="16,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="{StaticResource PrimaryBrush}" FontSize="7" VerticalAlignment="Center" />
                        <TextBlock Text="Encrypted &amp; Synced" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastSyncTimeText, StringFormat='Last synced at {0}'}" Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DeviceCountText, StringFormat='{}{0} · Online'}" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 4. ADD / EDIT KEY MODAL OVERLAY (Obsidian Vault v2)      -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsAddKeyDialogOpen}" Background="#b3030712" Padding="20">
            <Border Width="500" Background="{StaticResource SurfaceContainerBrush}" BorderBrush="{StaticResource BorderFocusBrush}" BorderThickness="1" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <!-- Dialog Header -->
                    <TextBlock Text="{Binding KeyDialogTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />

                    <!-- Key Address -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="KEY ADDRESS (e.g. anthropic/intent, openai/personal, stripe/live)" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                        <TextBox Text="{Binding KeyDialogAddress}" Height="36" Watermark="provider/name (e.g. anthropic/intent)">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Secret Value -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="API KEY / SECRET VALUE" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                        <TextBox Text="{Binding KeyDialogSecret}" Height="36" Watermark="Enter secret key..." PasswordChar="•">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Comment -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="COMMENT / DESCRIPTION (OPTIONAL)" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                        <TextBox Text="{Binding KeyDialogComment}" Height="36" Watermark="Production billing key, personal project...">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Tags -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="TAGS (OPTIONAL, e.g. intent, personal, dev)" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                        <TextBox Text="{Binding KeyDialogTags}" Height="36" Watermark="intent, personal, dev...">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Expiration Date (Calendar Input) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="EXPIRATION DATE (OPTIONAL)" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                        <Grid ColumnDefinitions="*, Auto">
                            <CalendarDatePicker Grid.Column="0"
                                                SelectedDate="{Binding KeyDialogExpiresDate}"
                                                Watermark="Pick expiration date..."
                                                HorizontalAlignment="Stretch"
                                                Height="36" />
                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearExpirationDateCommand}"
                                    Classes="secondary" Margin="8,0,0,0" Height="36" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <Button Content="+30d" Command="{Binding SetExpirationDaysCommand}" CommandParameter="30" Classes="subtle" FontSize="11" Padding="8,4" />
                            <Button Content="+90d" Command="{Binding SetExpirationDaysCommand}" CommandParameter="90" Classes="subtle" FontSize="11" Padding="8,4" />
                            <Button Content="+180d" Command="{Binding SetExpirationDaysCommand}" CommandParameter="180" Classes="subtle" FontSize="11" Padding="8,4" />
                            <Button Content="+1 Year" Command="{Binding SetExpirationDaysCommand}" CommandParameter="365" Classes="subtle" FontSize="11" Padding="8,4" />
                            <Button Content="No Expiry" Command="{Binding ClearExpirationDateCommand}" Classes="subtle" FontSize="11" Padding="8,4" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Security Status Checkboxes (Only visible when editing an existing key!) -->
                    <Border Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                            IsVisible="{Binding KeyDialogIsEditing}">
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding KeyDialogIsCompromised}"
                                      Content="Flag as Compromised (secret was exposed or leaked)"
                                      FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusDangerBrush}" />
                            <CheckBox IsChecked="{Binding KeyDialogIsRevoked}"
                                      Content="Mark as Revoked (key decommissioned / inactive)"
                                      FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding KeyDialogErrorMessage}" Foreground="{StaticResource StatusDangerBrush}"
                               IsVisible="{Binding KeyDialogErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Dialog Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelKeyDialogCommand}" Classes="secondary" IsCancel="True" Height="36" />
                        <Button Content="Save Key" Command="{Binding SaveKeyDialogCommand}" Classes="primary" IsDefault="True" Height="36" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
