<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiKeyVault.UI.ViewModels"
        xmlns:c="using:ApiKeyVault.UI.Controls"
        x:Class="ApiKeyVault.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ApiKeyVault"
        Icon="/Assets/app.ico"
        Width="1100" Height="720"
        MinWidth="880" MinHeight="560"
        Background="{StaticResource SurfaceLowestBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Faint dot grid used behind the welcome / unlock cards -->
        <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Stretch="None"
                      SourceRect="0,0,22,22" DestinationRect="0,0,22,22">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#1cffffff">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Rect="0,0,1.6,1.6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Window.Styles>
        <!-- Responsive key table: ListPane gets .compact / .narrow from code-behind -->
        <Style Selector=":is(Control).statusCol">
            <Setter Property="Width" Value="100" />
        </Style>
        <Style Selector=":is(Control).tagsCol">
            <Setter Property="Width" Value="96" />
        </Style>
        <Style Selector="Border#ListPane.compact :is(Control).tagsCol">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#ListPane.narrow :is(Control).statusCol">
            <Setter Property="Width" Value="30" />
        </Style>
        <Style Selector="Border#ListPane.narrow TextBlock.statusLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#ListPane.narrow TextBlock.statusHeader">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border#ListPane.narrow Border.statusPill">
            <Setter Property="Padding" Value="5" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- ======================================================== -->
        <!-- 0. HERO BACKDROP (shared by first-run + lock screens)    -->
        <!-- ======================================================== -->
        <Panel IsVisible="{Binding !IsUnlocked}" IsHitTestVisible="False">
            <Border Background="{StaticResource DotGridBrush}">
                <Border.OpacityMask>
                    <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="60%" RadiusY="70%">
                        <GradientStop Offset="0" Color="#ffffffff" />
                        <GradientStop Offset="1" Color="#00ffffff" />
                    </RadialGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="55%" RadiusY="60%">
                        <GradientStop Offset="0" Color="#3310b981" />
                        <GradientStop Offset="0.6" Color="#0a10b981" />
                        <GradientStop Offset="1" Color="#0010b981" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <!-- ======================================================== -->
        <!-- 1. FIRST RUN WIZARD                                      -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsFirstRun}" Padding="24" AutomationProperties.AutomationId="FirstRun.View">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Classes="card elevated" Width="540" Padding="36,32" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="18">
                        <!-- Branding -->
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border CornerRadius="16" BoxShadow="0 10 40 0 #6610b981" HorizontalAlignment="Center">
                                <c:LogoMark Width="56" Height="56" />
                            </Border>
                            <TextBlock Text="Create your vault" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="One encrypted file for every API key, synced across all your devices."
                                       TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" FontSize="13" />
                        </StackPanel>

                        <!-- Vault Folder Selection -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="VAULT STORAGE FOLDER" />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding FirstRunDirectory}" AutomationProperties.AutomationId="FirstRun.Directory" Height="38">
                                    <TextBox.InnerLeftContent>
                                        <c:Icon Data="{StaticResource Icon.Folder}" Width="15" Height="15" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFirstRunFolderCommand}" Classes="secondary" Margin="8,0,0,0" Height="38" Padding="14,0" />
                            </Grid>
                            <TextBlock Classes="helper" Text="Tip: a OneDrive, Dropbox or Git folder keeps the vault in sync between machines." />
                        </StackPanel>

                        <!-- Vault File Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="VAULT FILENAME" />
                            <TextBox Text="{Binding FirstRunFileName}" AutomationProperties.AutomationId="FirstRun.FileName" Height="38" />
                        </StackPanel>

                        <!-- Target path preview -->
                        <Border Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <c:Icon Grid.Column="0" Data="{StaticResource Icon.Database}" Width="14" Height="14" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding FirstRunVaultPath}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Command="{Binding CopyTargetVaultPathCommand}" Classes="subtle" Foreground="{StaticResource SecondaryBrush}" Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Center" ToolTip.Tip="Copy path">
                                    <c:Icon Data="{StaticResource Icon.Copy}" Width="13" Height="13" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Master Passphrase & Strength Meter -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="MASTER PASSPHRASE" />
                            <TextBox PasswordChar="•" Text="{Binding FirstRunPassphrase}" AutomationProperties.AutomationId="FirstRun.Passphrase" Height="38">
                                <TextBox.InnerLeftContent>
                                    <c:Icon Data="{StaticResource Icon.Key}" Width="15" Height="15" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreateVaultCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <!-- 4-Segment Strength Bar -->
                            <Grid ColumnDefinitions="*, *, *, *" Margin="0,4,0,0">
                                <Panel Grid.Column="0" Margin="0,0,2,0">
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceContainerHighestBrush}" />
                                    <Border Height="4" CornerRadius="2" Background="{Binding PassphraseStrengthColor}" IsVisible="{Binding IsStrengthBar1Active}" />
                                </Panel>
                                <Panel Grid.Column="1" Margin="2,0,2,0">
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceContainerHighestBrush}" />
                                    <Border Height="4" CornerRadius="2" Background="{Binding PassphraseStrengthColor}" IsVisible="{Binding IsStrengthBar2Active}" />
                                </Panel>
                                <Panel Grid.Column="2" Margin="2,0,2,0">
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceContainerHighestBrush}" />
                                    <Border Height="4" CornerRadius="2" Background="{Binding PassphraseStrengthColor}" IsVisible="{Binding IsStrengthBar3Active}" />
                                </Panel>
                                <Panel Grid.Column="3" Margin="2,0,0,0">
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceContainerHighestBrush}" />
                                    <Border Height="4" CornerRadius="2" Background="{Binding PassphraseStrengthColor}" IsVisible="{Binding IsStrengthBar4Active}" />
                                </Panel>
                            </Grid>

                            <TextBlock Text="{Binding PassphraseStrengthText}" FontSize="11" FontWeight="Medium" Foreground="{Binding PassphraseStrengthColor}" />
                        </StackPanel>

                        <!-- Confirm Passphrase -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="CONFIRM PASSPHRASE" />
                            <TextBox PasswordChar="•" Text="{Binding FirstRunConfirmPassphrase}" AutomationProperties.AutomationId="FirstRun.ConfirmPassphrase" Height="38">
                                <TextBox.InnerLeftContent>
                                    <c:Icon Data="{StaticResource Icon.Key}" Width="15" Height="15" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreateVaultCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Error Message -->
                        <Border Classes="banner danger" IsVisible="{Binding FirstRunErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto, *">
                                <c:Icon Data="{StaticResource Icon.Alert}" Width="15" Height="15" Foreground="{StaticResource StatusDangerBrush}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding FirstRunErrorMessage}" Foreground="#fda4af" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Primary Action -->
                        <Button Command="{Binding CreateVaultCommand}"
                                Classes="primary" HorizontalAlignment="Stretch"
                                IsDefault="True"
                                AutomationProperties.AutomationId="FirstRun.CreateButton" Height="44" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource Icon.ShieldCheck}" Width="16" Height="16" />
                                <TextBlock Text="Create Encrypted Vault" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Crypto feature strip -->
                        <Grid ColumnDefinitions="*, *, *" Margin="0,2,0,0">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Lock}" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="XChaCha20-Poly1305" FontSize="10.5" Foreground="{StaticResource OnSurfaceDimBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Cpu}" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Argon2id key derivation" FontSize="10.5" Foreground="{StaticResource OnSurfaceDimBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Monitor}" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Device-bound unlock" FontSize="10.5" Foreground="{StaticResource OnSurfaceDimBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,2" />

                        <!-- Footer Links -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Command="{Binding ChooseExistingVaultOnFirstRunCommand}" Classes="subtle">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                                    <TextBlock Text="Open existing vault…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SwitchToLockScreenCommand}" Classes="subtle">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Unlock}" Width="14" Height="14" />
                                    <TextBlock Text="Go to unlock screen" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. LOCK SCREEN                                           -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsLocked}" Padding="24" AutomationProperties.AutomationId="Unlock.View">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Classes="card elevated" Width="460" Padding="32" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <!-- Branding -->
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border CornerRadius="16" BoxShadow="0 10 40 0 #6610b981" HorizontalAlignment="Center">
                                <c:LogoMark Width="56" Height="56" />
                            </Border>
                            <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="Enter your master passphrase to unlock the vault." Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center" FontSize="13" />
                        </StackPanel>

                        <!-- Targeted Vault Card -->
                        <Border Classes="well" Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Classes="iconTile" Width="36" Height="36" Margin="0,0,12,0">
                                    <c:Icon Data="{StaticResource Icon.Database}" Width="17" Height="17" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetVaultFileName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TargetVaultDirectory}" Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TargetVaultDirectory}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Change" Command="{Binding BrowseOtherVaultCommand}" Classes="secondary" Height="30" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Passphrase Field -->
                        <TextBox PasswordChar="•" Text="{Binding UnlockPassphrase}"
                                 AutomationProperties.AutomationId="Unlock.Passphrase"
                                 Watermark="Master passphrase" Height="42">
                            <TextBox.InnerLeftContent>
                                <c:Icon Data="{StaticResource Icon.Lock}" Width="15" Height="15" Margin="12,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                            </TextBox.InnerLeftContent>
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <!-- Error Message -->
                        <Border Classes="banner danger" IsVisible="{Binding UnlockErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto, *">
                                <c:Icon Data="{StaticResource Icon.Alert}" Width="15" Height="15" Foreground="{StaticResource StatusDangerBrush}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding UnlockErrorMessage}" Foreground="#fda4af" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Unlock Button -->
                        <Button Command="{Binding UnlockCommand}"
                                Classes="primary" HorizontalAlignment="Stretch"
                                IsDefault="True"
                                AutomationProperties.AutomationId="Unlock.Button" Height="42">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource Icon.Unlock}" Width="16" Height="16" />
                                <TextBlock Text="Unlock Vault" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Recent Vaults Section -->
                        <StackPanel Spacing="8" Margin="0,6,0,0" IsVisible="{Binding RecentVaults.Count}">
                            <TextBlock Classes="label" Text="RECENT VAULTS" />
                            <ItemsControl ItemsSource="{Binding RecentVaults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:RecentVaultItemViewModel">
                                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,2">
                                            <Button Grid.Column="0" Classes="subtle" Padding="8,6"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectRecentVaultCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,10,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DirectoryPath}" FontSize="10.5" Foreground="{StaticResource OnSurfaceDimBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <Border Grid.Column="1" IsVisible="{Binding IsActive}" Background="{StaticResource PrimarySurfaceBrush}" CornerRadius="999" Padding="8,2" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="Current" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}" />
                                            </Border>

                                            <Button Grid.Column="2" Classes="subtle" Padding="6" VerticalAlignment="Center" ToolTip.Tip="Remove from recent list"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentVaultCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource Icon.X}" Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Margin="0,2" />

                        <!-- Lock Screen Bottom Links -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Command="{Binding CreateNewVaultFromLockScreenCommand}" Classes="subtle">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                                    <TextBlock Text="Create new vault" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BrowseOtherVaultCommand}" Classes="subtle">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                                    <TextBlock Text="Open other file…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. UNLOCKED MAIN WORKSPACE                               -->
        <!-- ======================================================== -->
        <Grid IsVisible="{Binding IsUnlocked}" RowDefinitions="*, Auto">
            <!-- Sidebar | Key List | Collapsible Inspector -->
            <Grid Grid.Row="0" ColumnDefinitions="208, *, Auto">
                <!-- ==================== COLUMN 0: SIDEBAR ==================== -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
                    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                        <!-- 1. Logo & Vault -->
                        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,0">
                                <c:LogoMark Width="30" Height="30" />
                                <TextBlock Text="ApiKeyVault" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Classes="well" Padding="10,8" Background="{StaticResource SurfaceContainerBrush}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Classes="iconTile" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                                        <c:Icon Data="{StaticResource Icon.Database}" Width="15" Height="15" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding ActiveVaultFileName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActiveVaultPath}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Unlocked" FontSize="10.5" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 2. Search -->
                        <TextBox Grid.Row="1" x:Name="SearchBox" Text="{Binding SearchText}"
                                 Watermark="Search keys"
                                 Height="36" Margin="0,0,0,10" Padding="8,8"
                                 AutomationProperties.AutomationId="Search.Box">
                            <TextBox.InnerLeftContent>
                                <c:Icon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <Border Classes="kbd" Margin="0,0,8,0">
                                    <TextBlock Text="Ctrl K" />
                                </Border>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <!-- 3. Primary CTA -->
                        <Button Grid.Row="2" Command="{Binding OpenAddKeyDialogCommand}"
                                Classes="primary" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,16"
                                AutomationProperties.AutomationId="Nav.AddKey">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15" StrokeThickness="2.4" />
                                <TextBlock Text="Add API Key" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 4. Navigation -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="-4,0">
                            <StackPanel Spacing="2" Margin="4,0">
                                <Button Classes="nav" Classes.active="{Binding IsAllFilterActive}"
                                        Command="{Binding SetFilterCommand}" CommandParameter="all"
                                        AutomationProperties.AutomationId="Nav.AllKeys">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <c:Icon Data="{StaticResource Icon.Layers}" Width="15" Height="15" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="All Keys" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Classes="count">
                                            <TextBlock Text="{Binding TotalKeysCount}" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button Classes="nav" Classes.active="{Binding IsAttentionFilterActive}"
                                        Command="{Binding SetFilterCommand}" CommandParameter="attention"
                                        AutomationProperties.AutomationId="Nav.Attention">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <c:Icon Data="{StaticResource Icon.Alert}" Width="15" Height="15" Margin="0,0,10,0" Foreground="{StaticResource StatusWarningBrush}" />
                                        <TextBlock Grid.Column="1" Text="Needs Attention" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Classes="count" Classes.warn="{Binding AttentionCount}">
                                            <TextBlock Text="{Binding AttentionCount}" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <TextBlock Classes="section" Text="TAGS" Margin="10,16,0,6" IsVisible="{Binding TagFilters.Count}" />
                                <ItemsControl ItemsSource="{Binding TagFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TagFilterItemViewModel">
                                            <Button Classes="nav" Classes.active="{Binding IsActive}" Margin="0,1"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetFilterCommand}"
                                                    CommandParameter="{Binding Tag, StringFormat='tag:{0}'}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <c:Icon Data="{StaticResource Icon.Hash}" Width="14" Height="14" Foreground="{Binding Color}" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Tag}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="2" Classes="count">
                                                        <TextBlock Text="{Binding Count}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="section" Text="PLATFORMS" Margin="10,16,0,6" IsVisible="{Binding ProviderFilters.Count}" />
                                <ItemsControl ItemsSource="{Binding ProviderFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ProviderFilterItemViewModel">
                                            <Button Classes="nav" Classes.active="{Binding IsActive}" Margin="0,1"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetFilterCommand}"
                                                    CommandParameter="{Binding Name}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Tint}" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="Bold" Foreground="{Binding Color}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="2" Classes="count">
                                                        <TextBlock Text="{Binding Count}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 5. Bottom Utilities -->
                        <Border Grid.Row="4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                <Button Grid.Row="0" Grid.ColumnSpan="2" Classes="nav" Margin="0,0,0,4"
                                        Command="{Binding OpenRecoveryDialogCommand}"
                                        ToolTip.Tip="Generate a new recovery code (revokes the current one)"
                                        AutomationProperties.AutomationId="Nav.RecoveryCode">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <c:Icon Data="{StaticResource Icon.LifeBuoy}" Width="15" Height="15" />
                                        <TextBlock Text="Recovery Code" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="0" Classes="nav"
                                        Command="{Binding SwitchVaultCommand}"
                                        AutomationProperties.AutomationId="Nav.SwitchVault">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <c:Icon Data="{StaticResource Icon.Folder}" Width="15" Height="15" />
                                        <TextBlock Text="Switch Vault" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Classes="secondary" Padding="9,7" Margin="6,0,0,0"
                                        Command="{Binding LockCommand}"
                                        ToolTip.Tip="Lock vault"
                                        AutomationProperties.AutomationId="Nav.Lock">
                                    <c:Icon Data="{StaticResource Icon.Lock}" Width="15" Height="15" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== COLUMN 1: KEY LIST ==================== -->
                <Border Grid.Column="1" x:Name="ListPane" Background="{StaticResource SurfaceBaseBrush}" SizeChanged="OnListPaneSizeChanged">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <!-- Title bar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="22,18,14,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilterTitle}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                <Border Classes="count" Padding="8,2">
                                    <TextBlock Text="{Binding FilteredCountText}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ToggleInspectorCommand}"
                                    Classes="subtle" Padding="7" VerticalAlignment="Center"
                                    ToolTip.Tip="Toggle details panel">
                                <c:Icon Data="{StaticResource Icon.PanelRight}" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <!-- Column headers -->
                        <Border Grid.Row="1" IsVisible="{Binding !HasNoKeys}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="28,6,28,8">
                            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                <TextBlock Grid.Column="0" Classes="section" Margin="0" Text="KEY" />
                                <TextBlock Grid.Column="1" Classes="section statusCol statusHeader" Margin="0" Text="STATUS" />
                                <TextBlock Grid.Column="2" Classes="section tagsCol" Margin="0" Text="TAGS" />
                                <TextBlock Grid.Column="3" Classes="section" Margin="0" Width="56" Text="EXPIRES" TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 Background="Transparent" Padding="0,6"
                                 Tapped="OnEntryListTapped"
                                 AutomationProperties.AutomationId="Entry.List">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:EntryItemViewModel">
                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto" ClipToBounds="True">
                                        <!-- Provider avatar + name -->
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto, *" Margin="0,0,10,0">
                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{Binding ProviderTint}" BorderBrush="{Binding ProviderBorder}" BorderThickness="1"
                                                    VerticalAlignment="Center" ToolTip.Tip="{Binding ProviderDisplayName}">
                                                <TextBlock Text="{Binding ProviderInitial}" Foreground="{Binding ProviderColor}" FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Address}" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Status pill -->
                                        <Panel Grid.Column="1" Classes="statusCol">
                                            <Border Classes="statusPill" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1"
                                                    CornerRadius="999" Padding="8,2,9,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding StatusText}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="statusLabel" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Panel>

                                        <!-- Tags -->
                                        <StackPanel Grid.Column="2" Classes="tagsCol" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" ClipToBounds="True">
                                            <ItemsControl ItemsSource="{Binding VisibleTagBadges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:TagBadgeViewModel">
                                                        <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}"
                                                                BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding Tooltip}">
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding ForegroundColor}" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border IsVisible="{Binding HasOverflowTags}"
                                                    Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1" CornerRadius="5" Padding="4,1" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding TagsDisplay}">
                                                <TextBlock Text="{Binding OverflowTagText}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock IsVisible="{Binding HasNoTags}" Text="—"
                                                       Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="11" Opacity="0.5"
                                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                                        </StackPanel>

                                        <!-- Expiry -->
                                        <TextBlock Grid.Column="3" Text="{Binding ExpiryTableDescription}" ToolTip.Tip="{Binding ExpiryDescription}"
                                                   Foreground="{Binding ExpiryColor}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Width="56" TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty vault -->
                        <StackPanel Grid.Row="2" IsVisible="{Binding HasNoKeys}" Spacing="14" MaxWidth="320"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <!-- Stacked-cards illustration -->
                            <Canvas Width="150" Height="104" HorizontalAlignment="Center">
                                <Border Canvas.Left="22" Canvas.Top="14" Width="104" Height="66" CornerRadius="12"
                                        Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-9" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="26" Canvas.Top="18" Width="104" Height="66" CornerRadius="12"
                                        Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="7" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="23" Canvas.Top="26" Width="104" Height="66" CornerRadius="12"
                                        Background="{StaticResource SurfaceContainerHighestBrush}" BorderBrush="#5910b981" BorderThickness="1"
                                        BoxShadow="0 12 30 0 #8c000000" Padding="12">
                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="*, *">
                                        <Border Grid.RowSpan="2" Classes="iconTile" Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <c:Icon Data="{StaticResource Icon.Key}" Width="16" Height="16" />
                                        </Border>
                                        <Border Grid.Column="1" Grid.Row="0" Height="6" CornerRadius="3" Background="#33eef2f7" VerticalAlignment="Bottom" Margin="0,0,6,4" />
                                        <Border Grid.Column="1" Grid.Row="1" Height="5" CornerRadius="3" Background="#1aeef2f7" VerticalAlignment="Top" Margin="0,3,22,0" />
                                    </Grid>
                                </Border>
                            </Canvas>
                            <TextBlock Text="Your vault is empty" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Add your first API key, import an existing .env file, or load sample keys to explore."
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            <StackPanel Spacing="8" Margin="0,6,0,0">
                                <Button Command="{Binding OpenAddKeyDialogCommand}" Classes="primary" HorizontalAlignment="Stretch" Height="38">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <c:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15" StrokeThickness="2.4" />
                                        <TextBlock Text="Add API Key" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="*, *">
                                    <Button Grid.Column="0" Margin="0,0,4,0" Command="{Binding ImportKeysCommand}" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:Icon Data="{StaticResource Icon.Import}" Width="14" Height="14" />
                                            <TextBlock Text="Import .env / JSON" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding PopulateDemoKeysCommand}" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:Icon Data="{StaticResource Icon.Sparkles}" Width="14" Height="14" />
                                            <TextBlock Text="Sample keys" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- No matches -->
                        <StackPanel Grid.Row="2" IsVisible="{Binding HasNoMatchingEntries}" Spacing="10" MaxWidth="300"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Search}" Width="22" Height="22" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            </Border>
                            <TextBlock Text="No matching keys" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="Nothing matches the current search or filter." TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                            <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Classes="secondary" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== COLUMN 2: INSPECTOR (COLLAPSIBLE) ==================== -->
                <Border Grid.Column="2" Width="316" IsVisible="{Binding IsInspectorVisible}"
                        Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                        Padding="12" AutomationProperties.AutomationId="Detail.Pane">
                    <Grid>
                        <!-- Nothing selected -->
                        <StackPanel IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}"
                                    Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220">
                            <Border Width="56" Height="56" CornerRadius="16" Classes="iconTile" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource Icon.Key}" Width="24" Height="24" />
                            </Border>
                            <TextBlock Text="No key selected" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="Pick a key from the list to view, copy or edit it."
                                       TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceMutedBrush}" TextAlignment="Center" FontSize="12" />
                        </StackPanel>

                        <!-- Key Selected Inspector Card -->
                        <Border Classes="card" CornerRadius="14" Padding="0"
                                IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                                <StackPanel Spacing="14" Margin="16,16,16,14">
                                    <!-- Header -->
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                                                Background="{Binding SelectedEntry.ProviderTint}" BorderBrush="{Binding SelectedEntry.ProviderBorder}" BorderThickness="1"
                                                VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding SelectedEntry.ProviderInitial}" Foreground="{Binding SelectedEntry.ProviderColor}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.Address}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedEntry.Address}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{Binding SelectedEntry.StatusBackground}" BorderBrush="{Binding SelectedEntry.StatusBorder}" BorderThickness="1"
                                                        CornerRadius="999" Padding="7,1,8,2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding SelectedEntry.StatusColor}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SelectedEntry.StatusText}" Foreground="{Binding SelectedEntry.StatusColor}" FontSize="10.5" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedEntry.ProviderDisplayName}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding CloseInspectorCommand}"
                                                Classes="subtle" Padding="6" VerticalAlignment="Top" Margin="6,-2,-4,0"
                                                ToolTip.Tip="Close details panel">
                                            <c:Icon Data="{StaticResource Icon.X}" Width="13" Height="13" />
                                        </Button>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding SelectedEntry.Comment}" FontSize="12" Foreground="{StaticResource OnSurfaceMutedBrush}"
                                               TextWrapping="Wrap" IsVisible="{Binding SelectedEntry.HasComment}" Margin="0,-4,0,0" />

                                    <!-- Compromised Alert -->
                                    <Border Classes="banner danger" IsVisible="{Binding SelectedEntry.IsCompromised}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <c:Icon Data="{StaticResource Icon.ShieldAlert}" Width="16" Height="16" Foreground="#fb7185" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Marked as compromised" FontWeight="Bold" FontSize="12" Foreground="#fb7185" />
                                                <TextBlock Text="This key may be leaked. Rotate or revoke it immediately." FontSize="11" Foreground="#fda4af" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Expiring Alert -->
                                    <Border Classes="banner warning" IsVisible="{Binding SelectedEntry.IsExpiringSoon}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <c:Icon Data="{StaticResource Icon.Clock}" Width="16" Height="16" Foreground="{StaticResource StatusWarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Expires soon" FontWeight="Bold" FontSize="12" Foreground="{StaticResource StatusWarningBrush}" />
                                                <TextBlock Text="{Binding SelectedEntry.ExpiryDescription}" FontSize="11" Foreground="#fcd34d" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Revoked Alert -->
                                    <Border Classes="banner neutral" IsVisible="{Binding SelectedEntry.IsRevoked}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <c:Icon Data="{StaticResource Icon.Ban}" Width="16" Height="16" Foreground="{StaticResource OnSurfaceMutedBrush}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="This key has been revoked and is inactive." FontSize="11.5" Foreground="{StaticResource OnSurfaceMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Secret -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="SECRET" />
                                        <TextBox Classes="mono" Text="{Binding RevealedSecret}" IsReadOnly="True" Height="38">
                                            <TextBox.InnerRightContent>
                                                <Button Command="{Binding ToggleRevealSecretCommand}" Classes="subtle" Padding="7" Margin="0,0,4,0"
                                                        ToolTip.Tip="Show / hide secret"
                                                        AutomationProperties.AutomationId="Entry.Reveal">
                                                    <Panel>
                                                        <c:Icon Data="{StaticResource Icon.Eye}" Width="15" Height="15" IsVisible="{Binding !IsSecretRevealed}" />
                                                        <c:Icon Data="{StaticResource Icon.EyeOff}" Width="15" Height="15" IsVisible="{Binding IsSecretRevealed}" />
                                                    </Panel>
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <Button Command="{Binding CopySecretCommand}"
                                                Classes="primary" HorizontalAlignment="Stretch" Height="40" Margin="0,2,0,0"
                                                AutomationProperties.AutomationId="Entry.Copy">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <c:Icon Data="{StaticResource Icon.Copy}" Width="15" Height="15" />
                                                <TextBlock Text="Copy Key" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                                    IsVisible="{Binding ClipboardCountdownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <c:Icon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{StaticResource SecondaryBrush}" StrokeThickness="2.6" />
                                            <TextBlock Text="{Binding ClipboardCountdownText}" FontSize="11" Foreground="{StaticResource SecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Details -->
                                    <Border Classes="well" Padding="14,4">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto, *" Margin="0,8">
                                                <TextBlock Text="Platform" FontSize="11.5" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedEntry.ProviderDisplayName}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Separator />
                                            <Grid ColumnDefinitions="Auto, *" Margin="0,6">
                                                <TextBlock Text="Tags" FontSize="11.5" Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center" />
                                                <Panel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <ItemsControl ItemsSource="{Binding SelectedEntry.TagBadges}" IsVisible="{Binding SelectedEntry.HasTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:TagBadgeViewModel">
                                                                <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}"
                                                                        BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="2,1"
                                                                        ToolTip.Tip="{Binding Tooltip}">
                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding ForegroundColor}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="No tags" IsVisible="{Binding SelectedEntry.HasNoTags}"
                                                               FontSize="11.5" Foreground="{StaticResource OnSurfaceDimBrush}" HorizontalAlignment="Right" />
                                                </Panel>
                                            </Grid>
                                            <Separator />
                                            <Grid ColumnDefinitions="Auto, *" Margin="0,8">
                                                <TextBlock Text="Expires" FontSize="11.5" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedEntry.ExpiryDescription}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding SelectedEntry.ExpiryColor}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                                            </Grid>
                                            <Separator />
                                            <Grid ColumnDefinitions="Auto, *" Margin="0,8">
                                                <TextBlock Text="Last tested" FontSize="11.5" Foreground="{StaticResource OnSurfaceMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedEntry.TestStatusDescription}" FontSize="11.5" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                                           ToolTip.Tip="{Binding SelectedEntry.TestStatusDescription}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Security -->
                                    <Border Classes="well" Padding="14,10">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <c:Icon Grid.Column="0" Data="{StaticResource Icon.ShieldAlert}" Width="16" Height="16" Foreground="{StaticResource StatusDangerBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Compromised" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                                                <TextBlock Text="Flag if this secret was leaked or exposed." FontSize="11" Foreground="{StaticResource OnSurfaceDimBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding SelectedEntry.IsCompromised, Mode=OneWay}"
                                                      Command="{Binding ToggleSelectedEntryCompromisedCommand}"
                                                      ToolTip.Tip="Mark as compromised"
                                                      MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Primary actions -->
                                    <Grid ColumnDefinitions="*, *" Margin="0,2,0,0">
                                        <Button Grid.Column="0" Margin="0,0,4,0" Command="{Binding ToggleSelectedEntryRevokedCommand}"
                                                Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                                AutomationProperties.AutomationId="Entry.Revoke">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Panel>
                                                    <c:Icon Data="{StaticResource Icon.Ban}" Width="14" Height="14" IsVisible="{Binding !SelectedEntry.IsRevoked}" />
                                                    <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" IsVisible="{Binding SelectedEntry.IsRevoked}" />
                                                </Panel>
                                                <TextBlock Text="{Binding SelectedEntry.RevokeButtonText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding OpenEditKeyDialogCommand}"
                                                Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                                AutomationProperties.AutomationId="Entry.Edit">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:Icon Data="{StaticResource Icon.Pencil}" Width="14" Height="14" />
                                                <TextBlock Text="Edit Key" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Utility actions -->
                                    <Grid ColumnDefinitions="*, *, *" Margin="-6,-4,-6,0">
                                        <Button Grid.Column="0" Command="{Binding TestSelectedEntryCommand}"
                                                IsEnabled="{Binding SelectedEntry.IsTestSupported}"
                                                ToolTip.Tip="{Binding SelectedEntry.TestSupportTooltip}"
                                                ToolTip.ShowOnDisabled="True"
                                                Classes="subtle" FontSize="11.5" HorizontalAlignment="Center" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <c:Icon Data="{StaticResource Icon.Activity}" Width="13" Height="13" />
                                                <TextBlock Text="Test" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding CopyAsCommandCommand}"
                                                ToolTip.Tip="Copy an 'akv run' command that injects this key"
                                                Classes="subtle" FontSize="11.5" HorizontalAlignment="Center" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <c:Icon Data="{StaticResource Icon.Terminal}" Width="13" Height="13" />
                                                <TextBlock Text="akv run" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding DeleteSelectedEntryCommand}"
                                                Classes="subtle dangerText" FontSize="11.5" HorizontalAlignment="Center" Padding="8,5"
                                                AutomationProperties.AutomationId="Entry.Delete">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <c:Icon Data="{StaticResource Icon.Trash}" Width="13" Height="13" />
                                                <TextBlock Text="Delete" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Status Strip -->
            <Border Grid.Row="1" Height="28" Background="{StaticResource SurfaceLowestBrush}" Padding="14,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*, Auto, *">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.ShieldCheck}" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Encrypted &amp; Synced" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.Refresh}" Width="11" Height="11" Foreground="{StaticResource OnSurfaceDimBrush}" />
                        <TextBlock Text="{Binding LastSyncTimeText, StringFormat='Last synced {0}'}" Foreground="{StaticResource OnSurfaceDimBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <c:Icon Data="{StaticResource Icon.Monitor}" Width="12" Height="12" Foreground="{StaticResource OnSurfaceDimBrush}" />
                        <TextBlock Text="{Binding DeviceCountText}" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="10.5" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBlock Text="Online" Foreground="{StaticResource OnSurfaceMutedBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 4. ADD / EDIT KEY MODAL                                  -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsAddKeyDialogOpen}" Background="#c4030509" Padding="20">
            <Border Classes="card elevated" Width="520" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderStrongBrush}">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="24,22,18,6">
                        <Border Grid.Column="0" Classes="iconTile" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                            <c:Icon Data="{StaticResource Icon.Key}" Width="18" Height="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KeyDialogTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                            <TextBlock Text="Encrypted before it ever touches disk." FontSize="12" Foreground="{StaticResource OnSurfaceDimBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CancelKeyDialogCommand}" Classes="subtle" Padding="7" VerticalAlignment="Top" ToolTip.Tip="Close (Esc)">
                            <c:Icon Data="{StaticResource Icon.X}" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <!-- Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="24,14,24,20">
                            <!-- Key Address -->
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="KEY ADDRESS" />
                                <TextBox Text="{Binding KeyDialogAddress}" Height="38" Watermark="provider/name">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                        <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Classes="helper" Text="e.g. anthropic/intent, openai/personal, stripe/live" />
                            </StackPanel>

                            <!-- Secret Value -->
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="API KEY / SECRET" />
                                <TextBox Classes="mono" Text="{Binding KeyDialogSecret}" Height="38" Watermark="Paste secret value" PasswordChar="•">
                                    <TextBox.InnerLeftContent>
                                        <c:Icon Data="{StaticResource Icon.Lock}" Width="14" Height="14" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                    </TextBox.InnerLeftContent>
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                        <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </StackPanel>

                            <!-- Comment + Tags -->
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="6">
                                    <TextBlock Classes="label" Text="DESCRIPTION" />
                                    <TextBox Text="{Binding KeyDialogComment}" Height="38" Watermark="Optional">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="6">
                                    <TextBlock Classes="label" Text="TAGS" />
                                    <TextBox Text="{Binding KeyDialogTags}" Height="38" Watermark="intent, personal, dev">
                                        <TextBox.InnerLeftContent>
                                            <c:Icon Data="{StaticResource Icon.Hash}" Width="13" Height="13" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                        </TextBox.InnerLeftContent>
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SaveKeyDialogCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelKeyDialogCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <!-- Expiration -->
                            <StackPanel Spacing="8">
                                <TextBlock Classes="label" Text="EXPIRATION DATE" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <CalendarDatePicker Grid.Column="0"
                                                        SelectedDate="{Binding KeyDialogExpiresDate}"
                                                        Watermark="No expiry"
                                                        HorizontalAlignment="Stretch"
                                                        Height="38" />
                                    <Button Grid.Column="1" Command="{Binding ClearExpirationDateCommand}" Classes="secondary" Margin="8,0,0,0" Height="38" Padding="11,0" ToolTip.Tip="Clear date">
                                        <c:Icon Data="{StaticResource Icon.X}" Width="13" Height="13" />
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="+30 days" Command="{Binding SetExpirationDaysCommand}" CommandParameter="30" Classes="chip" />
                                    <Button Content="+90 days" Command="{Binding SetExpirationDaysCommand}" CommandParameter="90" Classes="chip" />
                                    <Button Content="+180 days" Command="{Binding SetExpirationDaysCommand}" CommandParameter="180" Classes="chip" />
                                    <Button Content="+1 year" Command="{Binding SetExpirationDaysCommand}" CommandParameter="365" Classes="chip" />
                                    <Button Content="No expiry" Command="{Binding ClearExpirationDateCommand}" Classes="chip" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Security flags (edit only) -->
                            <Border Classes="well" Padding="14,10" IsVisible="{Binding KeyDialogIsEditing}">
                                <StackPanel Spacing="6">
                                    <CheckBox IsChecked="{Binding KeyDialogIsCompromised}" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Compromised" FontWeight="SemiBold" Foreground="#fb7185" />
                                            <TextBlock Text="— secret was exposed or leaked" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding KeyDialogIsRevoked}" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Revoked" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                                            <TextBlock Text="— key decommissioned / inactive" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Error -->
                            <Border Classes="banner danger" IsVisible="{Binding KeyDialogErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <c:Icon Data="{StaticResource Icon.Alert}" Width="15" Height="15" Foreground="{StaticResource StatusDangerBrush}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding KeyDialogErrorMessage}" Foreground="#fda4af" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16" Padding="24,14">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Classes="kbd"><TextBlock Text="Enter" /></Border>
                                <TextBlock Text="to save" FontSize="11" Foreground="{StaticResource OnSurfaceDimBrush}" VerticalAlignment="Center" />
                                <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Esc" /></Border>
                                <TextBlock Text="to cancel" FontSize="11" Foreground="{StaticResource OnSurfaceDimBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelKeyDialogCommand}" Classes="secondary" IsCancel="True" Height="36" Padding="16,0" />
                            <Button Grid.Column="2" Command="{Binding SaveKeyDialogCommand}" Classes="primary" IsDefault="True" Height="36" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" StrokeThickness="2.4" />
                                    <TextBlock Text="Save Key" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- 5. RECOVERY CODE MODAL                                   -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding IsRecoveryDialogOpen}" Background="#c4030509" Padding="20" AutomationProperties.AutomationId="Recovery.Dialog">
            <Border Classes="card elevated" Width="480" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderStrongBrush}">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="24,22,18,6">
                        <Border Grid.Column="0" Classes="iconTile" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                            <c:Icon Data="{StaticResource Icon.LifeBuoy}" Width="18" Height="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecoveryDialogTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                            <TextBlock Text="Opens the vault if you forget your passphrase." FontSize="12" Foreground="{StaticResource OnSurfaceDimBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CancelRecoveryDialogCommand}" IsVisible="{Binding IsRecoveryConfirmStep}"
                                Classes="subtle" Padding="7" VerticalAlignment="Top" ToolTip.Tip="Close (Esc)">
                            <c:Icon Data="{StaticResource Icon.X}" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Panel Margin="24,14,24,20">
                            <!-- Step 1: confirm the passphrase before replacing the code -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsRecoveryConfirmStep}">
                                <Border Classes="banner warning">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <c:Icon Data="{StaticResource Icon.Alert}" Width="16" Height="16" Foreground="{StaticResource StatusWarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" Foreground="#fcd34d"
                                                   Text="Generating a new code revokes your current one immediately. Any copy you saved before will stop working." />
                                    </Grid>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="MASTER PASSPHRASE" />
                                    <TextBox PasswordChar="•" Text="{Binding RecoveryPassphrase}" Height="38" Watermark="Confirm it's you"
                                             IsEnabled="{Binding !IsRecoveryBusy}"
                                             AutomationProperties.AutomationId="Recovery.Passphrase">
                                        <TextBox.InnerLeftContent>
                                            <c:Icon Data="{StaticResource Icon.Lock}" Width="14" Height="14" Margin="11,0,0,0" Foreground="{StaticResource OnSurfaceDimBrush}" />
                                        </TextBox.InnerLeftContent>
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding RegenerateRecoveryCodeCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelRecoveryDialogCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 2: show the code once and verify one group -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsRecoveryCodeStep}">
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource OnSurfaceMutedBrush}"
                                           Text="This code is shown only once. Store it in your password manager — it can't be displayed again." />
                                <Border Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14,14,10">
                                    <StackPanel Spacing="10">
                                        <SelectableTextBlock Text="{Binding RecoveryCode}" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold"
                                                             Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                                             AutomationProperties.AutomationId="Recovery.Code" />
                                        <Button Command="{Binding CopyRecoveryCodeCommand}" Classes="subtle" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Padding="10,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <c:Icon Data="{StaticResource Icon.Copy}" Width="13" Height="13" />
                                                <TextBlock Text="Copy" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="{Binding RecoveryCheckGroupNumber, StringFormat='TYPE GROUP {0} TO CONFIRM YOU SAVED IT'}" />
                                    <TextBox Classes="mono" Text="{Binding RecoveryCheckInput}" Height="38" Watermark="4 characters" MaxLength="4"
                                             AutomationProperties.AutomationId="Recovery.Check">
                                        <TextBox.InnerRightContent>
                                            <c:Icon Data="{StaticResource Icon.Check}" Width="15" Height="15" Margin="0,0,11,0" StrokeThickness="2.6"
                                                    Foreground="{StaticResource PrimaryBrush}" IsVisible="{Binding IsRecoveryCheckValid}" />
                                        </TextBox.InnerRightContent>
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding FinishRecoveryDialogCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16" Padding="24,14">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *" VerticalAlignment="Center" Margin="0,0,12,0"
                                  IsVisible="{Binding RecoveryErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <c:Icon Data="{StaticResource Icon.Alert}" Width="14" Height="14" Foreground="{StaticResource StatusDangerBrush}" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding RecoveryErrorMessage}" Foreground="#fda4af" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="0" Text="Checking passphrase…" FontSize="11.5" Foreground="{StaticResource OnSurfaceDimBrush}" VerticalAlignment="Center"
                                       IsVisible="{Binding IsRecoveryBusy}" />

                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelRecoveryDialogCommand}" Classes="secondary" Height="36" Padding="16,0"
                                    IsVisible="{Binding IsRecoveryConfirmStep}" />
                            <Button Grid.Column="2" Command="{Binding RegenerateRecoveryCodeCommand}" Classes="primary" Height="36" Margin="10,0,0,0"
                                    IsVisible="{Binding IsRecoveryConfirmStep}" IsEnabled="{Binding !IsRecoveryBusy}"
                                    AutomationProperties.AutomationId="Recovery.Generate">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                                    <TextBlock Text="Generate New Code" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding FinishRecoveryDialogCommand}" Classes="primary" Height="36" Margin="10,0,0,0"
                                    IsVisible="{Binding IsRecoveryCodeStep}" IsEnabled="{Binding IsRecoveryCheckValid}"
                                    AutomationProperties.AutomationId="Recovery.Done">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" StrokeThickness="2.4" />
                                    <TextBlock Text="I've Saved It" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
