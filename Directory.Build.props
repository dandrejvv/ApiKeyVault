<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep machine light: disable compiler daemons and node reuse -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Suppress CA1416 platform warnings since platform detection is handled dynamically -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Version Condition="'$(Version)' == ''">0.1.0-dev</Version>
    <Authors>Dandré Jansen van Vuuren</Authors>
    <Product>ApiKeyVault</Product>
  </PropertyGroup>
</Project>
